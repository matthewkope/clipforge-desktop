{
  "manifest_version": 3,
  "name": "ClipForge",
  "version": "0.1.0",
  "description": "Send the active tab or a copied media URL to ClipForge as MP4, MP3, or Markdown.",
  "permissions": ["activeTab", "clipboardRead", "tabs"],
  "host_permissions": ["http://127.0.0.1:38473/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ClipForge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
