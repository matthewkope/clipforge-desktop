{
  "manifest_version": 3,
  "name": "ClipForge",
  "version": "0.2.0",
  "description": "Send the active tab, a copied media URL, or a YouTube clip selection to ClipForge.",
  "permissions": ["activeTab", "clipboardRead", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:38473/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ClipForge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
